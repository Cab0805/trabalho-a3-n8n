    {
      "parameters": {
        "jsCode": "// Analise baseada no preço do Bitcoin vs preço-alvo\nconst precoBitcoin = $('HTTP Request - Bitcoin Price').item.json.bitcoin.usd;\nconst precoAlvo = $('Webhook').item.json.body.preco_alvo;\n\nlet sentimento;\nlet pontuacao;\nlet mensagem;\n\nif (precoBitcoin > precoAlvo) {\n  sentimento = 'Positivo';\n  pontuacao = precoBitcoin - precoAlvo;\n  mensagem = `Bitcoin acima do alvo! +$${pontuacao.toFixed(2)}`;\n} else if (precoBitcoin < precoAlvo) {\n  sentimento = 'Negativo';\n  pontuacao = precoBitcoin - precoAlvo;\n  mensagem = `Bitcoin abaixo do alvo! $${pontuacao.toFixed(2)}`;\n} else {\n  sentimento = 'Neutro';\n  pontuacao = 0;\n  mensagem = `Bitcoin exatamente no preço alvo.`;\n}\n\nreturn [{\n  json: {\n    preco_bitcoin: precoBitcoin,\n    preco_alvo: precoAlvo,\n    diferenca: pontuacao,\n    sentimento: sentimento,\n    mensagem: mensagem\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
