    {
      "parameters": {
        "jsCode": "// Analise de Sentimentos por palavras-chave\n// Recebe o texto do campo 'mensagem' enviado no body do webhook\n\nconst texto = $('Webhook').item.json.body.mensagem || '';\nconst textoLower = texto.toLowerCase();\n\n// Palavras positivas\nconst palavrasPositivas = [\n  'otimo', 'otima', 'excelente', 'bom', 'boa', 'maravilhoso', 'maravilhosa',\n  'perfeito', 'perfeita', 'incrivel', 'fantastico', 'fantastica', 'amei',\n  'adorei', 'gostei', 'feliz', 'alegre', 'satisfeito', 'satisfeita',\n  'recomendo', 'aprovado', 'aprovei', 'positivo', 'subiu', 'alta', 'lucro',\n  'ganho', 'valorizou', 'cresceu', 'subindo', 'aumento'\n];\n\n// Palavras negativas\nconst palavrasNegativas = [\n  'ruim', 'pessimo', 'pessima', 'terrivel', 'horrivel', 'odiei', 'odio',\n  'nao gostei', 'problema', 'erro', 'falha', 'decepcionante', 'triste',\n  'insatisfeito', 'insatisfeita', 'reprovado', 'negativo', 'caiu', 'baixa',\n  'prejuizo', 'perda', 'desvalorizou', 'caindo', 'queda', 'despencou'\n];\n\nlet pontuacao = 0;\nconst encontradas = { positivas: [], negativas: [] };\n\nfor (const palavra of palavrasPositivas) {\n  if (textoLower.includes(palavra)) {\n    pontuacao += 1;\n    encontradas.positivas.push(palavra);\n  }\n}\n\nfor (const palavra of palavrasNegativas) {\n  if (textoLower.includes(palavra)) {\n    pontuacao -= 1;\n    encontradas.negativas.push(palavra);\n  }\n}\n\nlet sentimento;\nif (pontuacao > 0) {\n  sentimento = 'Positivo';\n} else if (pontuacao < 0) {\n  sentimento = 'Negativo';\n} else {\n  sentimento = 'Neutro';\n}\n\nreturn [{\n  json: {\n    texto_original: texto,\n    sentimento: sentimento,\n    pontuacao: pontuacao,\n    palavras_encontradas: encontradas,\n    preco_alvo: $('Webhook').item.json.body.preco_alvo\n  }\n}];"
      },
